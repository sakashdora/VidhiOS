# NVIDIA_API_KEY: Primary high-speed Legal AI engine via NVIDIA NIM API (server-side only).
# Configure via Settings > Secrets (never commit real API keys).
NVIDIA_API_KEY=""
NVIDIA_MODEL="mistralai/mistral-large-4-1t-a52b"
NVIDIA_FAST_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# GEMINI_API_KEY: Secondary/multimodal AI engine (audio transcription, OCR, search grounding).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# NEON_DATABASE_URL / DATABASE_URL: Neon Serverless PostgreSQL connection string
# Paste your Neon connection string here (e.g. postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require)
DATABASE_URL=""
NEON_DATABASE_URL=""

# Optional external Supabase PostgreSQL deployment credentials
# When set in Vercel/Cloudflare/Node production, VidhiOS switches storage from local SQLite/file persistence to Supabase REST/PostgreSQL automatically.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
